# Transactional email provider / SMTP configuration for the service-request
# notification email. Copy to `.env` and fill in real values for local runs; set the
# same keys as environment variables in the serverless deployment. These back the
# EmailConfig shape in src/integration/email.ts and stay behind the EmailSender
# abstraction. Never commit real secrets.

# --- Required to actually SEND the service-request notification email ---
# SMTP relay host (provider-agnostic: SES / SendGrid / Postmark / Gmail / any SMTP).
#   Gmail:    smtp.gmail.com
#   Amazon SES (example region): email-smtp.eu-west-1.amazonaws.com
SMTP_HOST=smtp.gmail.com
# 465 for implicit TLS, 587 for STARTTLS (Gmail works with either; 587 is common).
SMTP_PORT=587
# true for implicit TLS (port 465); defaults to true when port is 465, false otherwise.
SMTP_SECURE=false
# SMTP username. For Gmail this is the full Gmail address (oudet.laurent@gmail.com).
SMTP_USER=oudet.laurent@gmail.com
# SMTP password / provider secret. For Gmail this MUST be a 16-char App Password
# (Google Account > Security > 2-Step Verification > App passwords) — NOT your normal
# Google password. Never commit the real value.
SMTP_PASS=
# Envelope "from" address shown to the recipient.
EMAIL_FROM=oudet.laurent@gmail.com

# --- Optional: recipient of the notifications ---
# Business inbox that receives service-request notifications (Requirement 4.7).
# OPTIONAL: when unset, it defaults to the business email in src/content/business.ts
# (oudet.laurent@gmail.com), so submissions reach the owner without setting this. Set it
# only to override that default with a different inbox.
# BUSINESS_EMAIL=oudet.laurent@gmail.com

# Scheduling_Page booking URL (design §11, Requirement 12). The external
# Scheduling_Service (e.g. Calendly) embeddable booking URL. PUBLIC_-prefixed so Astro
# inlines it into the statically pre-rendered Scheduling_Page at build time. Backs the
# SchedulingConfig shape in src/domain/scheduling.ts.
#
# UNSET by default: when empty/unset the Scheduling_Page shows the provisional
# "coming soon" placeholder (Requirement 12.5). Set it to the Scheduling_Service's embed
# URL to enable the in-page booking embed (Requirement 12.2); if the embed then fails to
# load, the page shows the business email + phone as an alternative (Requirement 12.4).
# PUBLIC_SCHEDULING_URL=https://calendly.com/your-handle/intro
